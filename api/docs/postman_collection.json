{
  "info": {
    "name": "Library Management System API",
    "description": "API collection for authentication, genre management and book management. Login as a LIBRARIAN to test protected book operations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "bookId", "value": "1" },
    { "key": "genreId", "value": "1" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.access_token) {",
                  "    pm.collectionVariables.set('token', response.access_token);",
                  "    console.log('JWT saved to collection variable token');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"YOUR_LIBRARIAN_EMAIL\",\n  \"password\": \"YOUR_PASSWORD\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "Create Genre",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Programming\"\n}"
            },
            "url": "{{baseUrl}}/genres"
          }
        },
        {
          "name": "Get All Genres",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/genres"
          }
        },
        {
          "name": "Get Genre By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/genres/{{genreId}}"
          }
        },
        {
          "name": "Update Genre",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Software Development\"\n}"
            },
            "url": "{{baseUrl}}/genres/{{genreId}}"
          }
        },
        {
          "name": "Delete Genre",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/genres/{{genreId}}"
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Create Book (Librarian)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Clean Code\",\n  \"author\": \"Robert C. Martin\",\n  \"isbn\": \"9780132350884\",\n  \"totalCopies\": 5,\n  \"description\": \"A handbook of agile software craftsmanship.\",\n  \"genreId\": 1\n}"
            },
            "url": "{{baseUrl}}/books"
          }
        },
        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books"
          }
        },
        {
          "name": "Get Books With Filters",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?genreId=1&search=Clean&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "genreId", "value": "1" },
                { "key": "search", "value": "Clean" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Book By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        },
        {
          "name": "Update Book (Librarian)",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalCopies\": 8\n}"
            },
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        },
        {
          "name": "Delete Book (Librarian)",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        }
      ]
    }
  ]
}
